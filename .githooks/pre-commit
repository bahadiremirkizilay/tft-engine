#!/bin/sh
# Runs tests, ruff and the audit before every commit (CLAUDE.md rule 4).
# Enable once per clone:  git config core.hooksPath .githooks
py=".venv/Scripts/python.exe"
[ -x "$py" ] || py=".venv/bin/python"
if [ ! -x "$py" ]; then
  echo "pre-commit: .venv not found; create it (README) before committing" >&2
  exit 1
fi
exec "$py" tools/verify.py
